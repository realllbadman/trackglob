SECRET_KEY=change-this-long-random-string
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=[BUSINESS EMAIL]
SMTP_PASSWORD=
# optional; send FROM this address (must be on a domain verified with your email provider)
SMTP_FROM=
OWNER_EMAIL=[BUSINESS EMAIL]
BUSINESS_NAME=[COURIER NAME]
# optional; defaults to initials of BUSINESS_NAME (max 4 letters)
BUSINESS_ABBR=
OWNER_PHONE=[PHONE]
WHATSAPP=[WHATSAPP]
# optional; year the business started — shown as "Since 2019" and "© 2019–<this year>"
FOUNDED_YEAR=
# optional override of the footer disclaimer
DISCLAIMER=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
TRACKING_PREFIX=CX
PUBLIC_BASE_URL=http://localhost:8006
DATABASE_URL=sqlite:///./tracking.db
SEED_DEMO=1
# Set to "production" to refuse booting with default SECRET_KEY / ADMIN_PASSWORD
APP_ENV=development
# Optional comma-separated list of extra origins allowed to call the API (CORS).
# Leave empty for same-origin only.
CORS_ORIGINS=
# optional; Smartsupp live-chat key — leave empty to disable the chat widget
SMARTSUPP_KEY=
